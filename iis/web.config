<?xml version="1.0" encoding="UTF-8"?>
<!--
    IIS reverse proxy in front of the FastAPI/uvicorn service on 127.0.0.1:8000.
    Provisioned by scripts/setup-iis.ps1 - hand-edits will survive reruns of that
    script only if you keep the structure intact.

    Notes:
      * The HTTP -> HTTPS redirect uses {HTTP_HOST} so the public hostname (and
        any LAN IP that resolves to this server) is preserved.
      * `responseBufferLimit="0"` is REQUIRED at the server level (set in
        applicationHost.config by setup-iis.ps1) for the render-progress SSE
        stream to work without buffering.
      * `maxAllowedContentLength` is bumped to 10 GiB so large source video
        uploads aren't rejected by IIS request filtering (the FastAPI side
        streams them to disk; IIS just needs to let them through).
-->
<configuration>
  <system.webServer>

    <rewrite>
      <rules>
        <!-- Redirect plain HTTP to HTTPS, preserving the full original URI
             (including the /vme application prefix). {REQUEST_URI} starts
             with a slash, so we don't add one between {HTTP_HOST} and it. -->
        <rule name="HTTP to HTTPS" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}{REQUEST_URI}" redirectType="Permanent" />
        </rule>

        <!-- Reverse proxy everything else to the FastAPI service. IIS strips
             the application prefix (/vme) before passing requests in, so
             {R:1} is the suffix - exactly what the backend expects. -->
        <rule name="ReverseProxyToBackend" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <!-- 4294967295 = uint32 max (~4 GiB), the largest value IIS accepts.
             Source video clips are uploaded as a single multipart request, so
             this caps the per-clip size. Files larger than this would need a
             chunked-upload protocol on both ends. -->
        <requestLimits maxAllowedContentLength="4294967295" />
      </requestFiltering>
    </security>


    <!-- Prevent IIS from compressing the SSE stream (text/event-stream).
         Compression buffers small frames and breaks live streaming. -->
    <httpCompression>
      <staticTypes>
        <remove mimeType="text/event-stream" />
        <add mimeType="text/event-stream" enabled="false" />
      </staticTypes>
      <dynamicTypes>
        <remove mimeType="text/event-stream" />
        <add mimeType="text/event-stream" enabled="false" />
      </dynamicTypes>
    </httpCompression>

  </system.webServer>
</configuration>
