<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- A broadcast has to outlive the screen. The foreground service
         stops Android freezing the process once the operator locks
         the phone; the wake lock keeps the CPU up while it is off.
         See StreamService for why the camera type is not declared. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Only to show the "VME is live" notification. Denying it costs
         the notification, not the broadcast. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- UVCAndroid talks to the adapter through UsbManager, not the
         platform camera service, but it still declares the camera
         permission internally. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Both marked not-required: the app must install on a phone whose
         USB host support is unknown, because finding that out is the
         point of the exercise. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="false"
        android:label="VME"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- HomeActivity is the launcher: the app is no longer a
             single-screen spike. -->
        <activity
            android:name=".ui.HomeActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.RosterImportActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".ui.MatchSetupActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".ui.LogoCropActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".ui.TeamSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Portrait now that the events grid, rotation, and per-team
             cards match the VME editor's courtside layout. Preview
             lives on a separate tab. -->
        <activity
            android:name=".ui.MatchLiveActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <service
            android:name=".StreamService"
            android:exported="false"
            android:foregroundServiceType="microphone|connectedDevice" />

        <!-- Grants read access on match.json when the operator taps
             "Export" and picks another app (Drive, Files, mail). File
             URIs cannot be passed cross-app since API 24; a content://
             from FileProvider is the sanctioned replacement. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>
    </application>

</manifest>
